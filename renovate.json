{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>chiva/renovate-config",
    "local>chiva/renovate-config:ha-integration"
  ],
  "enabledManagers": [
    "pep621",
    "homeassistant-manifest",
    "github-actions",
    "pre-commit"
  ],
  "packageRules": [
    {
      "description": "The library pin lives in manifest.json (users) and pyproject (tests): one PR, typed feat so it triggers a release, no stability wait for our own release.",
      "matchPackageNames": [
        "logrono-bus"
      ],
      "groupName": "logrono-bus",
      "semanticCommitType": "feat",
      "minimumReleaseAge": "0 days"
    }
  ]
}
